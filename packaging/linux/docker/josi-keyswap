#!/usr/bin/env python3
"""Puts the installation key from a restored backup in place.

A backup protected with the backup password carries the installation master
key. When it is restored onto another install, the web service cannot swap the
key itself: every service account reads only its own copy
(secrets/<role>/master-key), and none may write the others'. So the web service
leaves the key in the shared state folder and this root-owned helper, started by
josi-keyswap.path, does the swap:

  - the key must be exactly 64 hex characters, in a plain file;
  - every role's copy is replaced in place, keeping its owner and mode;
  - the keys being replaced are kept (root only) in /var/lib/josi/key-backups,
    so a wrong restore can be undone by hand;
  - the web and worker services restart to read the new key;
  - the queued file is always removed, good or bad, so this never loops.

Run as root inside the container.
"""
import os, re, shutil, subprocess, sys, time
from pathlib import Path

DATA = Path('/var/lib/josi/data')
PENDING = DATA / 'state' / 'master-key.pending'
ROLES = ('web', 'worker', 'migrate', 'bootstrap')
KEPT = Path('/var/lib/josi/key-backups')


def say(text):
    print('josi-keyswap: ' + text, flush=True)


def main():
    if not PENDING.exists() and not PENDING.is_symlink():
        return 0
    try:
        info = PENDING.lstat()
        if PENDING.is_symlink() or not PENDING.is_file() or info.st_size > 512:
            say('the queued key is not a plain small file; ignored')
            return 1
        text = PENDING.read_text().strip()
        if not re.fullmatch(r'[0-9a-f]{64}', text):
            say('the queued key is not 64 hex characters; ignored')
            return 1
        stamp = time.strftime('%Y%m%d-%H%M%S')
        keep = KEPT / stamp
        keep.mkdir(parents=True, mode=0o700, exist_ok=True)
        os.chmod(KEPT, 0o700)
        replaced = 0
        for role in ROLES:
            target = DATA / 'secrets' / role / 'master-key'
            if not target.is_file() or target.is_symlink():
                continue
            st = target.stat()
            shutil.copy2(target, keep / (role + '-master-key'))
            staged = target.with_name('master-key.new')
            if staged.exists():
                staged.unlink()
            fd = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, 'w') as handle:
                handle.write(text)
            os.chown(staged, st.st_uid, st.st_gid)
            os.chmod(staged, st.st_mode & 0o7777)
            os.replace(staged, target)
            replaced += 1
        say('replaced the installation key in %d places' % replaced)
        return 0 if replaced else 1
    finally:
        try:
            PENDING.unlink()
        except FileNotFoundError:
            pass
        # Let the page that asked for the restore finish its answer, then restart the services that hold the key.
        time.sleep(3)
        subprocess.run(['/usr/bin/systemctl', 'restart', 'josi-ce-web.service', 'josi-ce-worker.service'], check=False)


if __name__ == '__main__':
    sys.exit(main())
