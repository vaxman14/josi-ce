<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exercises PcWork (commands, files, programs) in the built Josi.exe through
       reflection, without a server. Build Josi first (dotnet build -c Release in
       apps/windows-native), then: dotnet run -c Release -\-project test\pcwork-probe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Probe.cs" />
    <Reference Include="Josi"><HintPath>..\..\bin\Release\net8.0-windows10.0.19041.0\Josi.dll</HintPath></Reference>
  </ItemGroup>
</Project>
