# Hey Josi hosted service. Copy to .env and fill in. No real values belong in
# this file. Keys marked "32 bytes" are base64url or hex; make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://accounts.heyjosi.com
# The domain addresses live under. Defaults to PUBLIC_ORIGIN's host.
PUBLIC_DOMAIN=heyjosi.com
# The header carrying the visitor's address behind a proxy. Set it only when
# nothing can reach this service except through that proxy.
CLIENT_IP_HEADER=cf-connecting-ip

# Supabase: use the pooler connection string.
DATABASE_URL=
# Optional: read the database password from this file instead.
# PGPASSWORD_FILE=

# 32 bytes. Seals TOTP secrets. Changing it strands everyone's two-step sign-in.
ACCOUNT_DATA_KEY=
# 32 bytes. Signs CSRF tokens and the Google state wrapper.
STATE_SIGNING_KEY=
# 32 bytes, X25519. The hosted Noise key. Servers pin the public half when they
# link, so changing it means every server has to link again.
HOSTED_NOISE_PRIVATE_KEY=
# 32 bytes, an Ed25519 seed. Its public half goes in the relay's ACCOUNTS_KEYS.
RELAY_GRANT_PRIVATE_KEY=
RELAY_URL=https://relay.heyjosi.com

# Stripe, test mode only. A live key stops the service from starting.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CONNECT=
STRIPE_PRICE_CONNECT_AI=
STRIPE_PRICE_TOPUP_10=
STRIPE_PRICE_TOPUP_20=

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Redirect URI is <PUBLIC_ORIGIN>/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# smtp in production. console prints sign-in links and is refused there.
MAIL_TRANSPORT=smtp
MAIL_FROM=Hey Josi <hello@heyjosi.com>
SMTP_URL=

# AI limits. These are the defaults.
AI_INCLUDED_USD=12
AI_MAX_OUTPUT_TOKENS=16384
AI_IMAGE_TOKENS=40000
AI_MAX_BODY_BYTES=4194304
AI_RESERVATION_TTL_SECONDS=900
AI_UPSTREAM_TIMEOUT_SECONDS=600
